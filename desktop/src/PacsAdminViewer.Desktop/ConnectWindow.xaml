<Window x:Class="PacsAdminViewer.Desktop.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Orthanc" Icon="Assets/app.ico"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="18">
    <Label Content="_Server address" Target="{Binding ElementName=ServerBox}" Padding="0,0,0,4" />
    <TextBox x:Name="ServerBox" Padding="3" />
    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
               Text="For example http://192.168.1.20:8042. Pasting the address of the Orthanc Explorer page works too." />

    <Label Content="_Username" Target="{Binding ElementName=UserBox}" Padding="0,12,0,4" />
    <TextBox x:Name="UserBox" Padding="3" />

    <Label Content="_Password" Target="{Binding ElementName=PasswordInput}" Padding="0,12,0,4" />
    <PasswordBox x:Name="PasswordInput" Padding="3" />
    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
               Text="Leave both empty if this Orthanc doesn't require a login." />

    <CheckBox x:Name="RememberBox" Margin="0,14,0,0"
              Content="_Remember password on this computer (encrypted for your Windows account)" />
    <CheckBox x:Name="AutoBox" Margin="0,6,0,0" Content="Connect _automatically when the app starts" />

    <TextBlock x:Name="ResultText" Margin="0,14,0,0" TextWrapping="Wrap" MinHeight="18" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="TestButton" Content="_Test connection" MinWidth="110" Padding="10,3" Margin="0,0,8,0" Click="Test_Click" />
      <Button x:Name="ConnectButton" Content="Connect" IsDefault="True" MinWidth="80" Padding="10,3" Margin="0,0,8,0" Click="Connect_Click" />
      <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" />
    </StackPanel>
  </StackPanel>
</Window>
