<Window x:Class="PacsAdminViewer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PACS Admin Viewer" Icon="Assets/app.ico"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="Black">
  <DockPanel>
    <!-- Shell bar: archive connection and app-level actions. Everything imaging-related is the viewer's toolbar below. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="8,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ConnectButton" Style="{StaticResource PrimaryShellButton}" Content="Connect…"
                  ToolTip="Connect to an Orthanc archive" Click="Connect_Click" />
          <Button x:Name="BrowseButton" Style="{StaticResource ShellButton}" Content="Study browser" IsEnabled="False"
                  ToolTip="Search the archive and open studies in the viewer" Click="Browse_Click" />
          <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Margin="8,0,6,0" VerticalAlignment="Center"
                   Fill="{StaticResource MutedBrush}" />
          <TextBlock x:Name="ConnectionText" Text="Not connected" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Column="1" Margin="20,0" VerticalAlignment="Center"
                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ShellButton}" Content="Logs" ToolTip="Open the folder with this app's log files" Click="Logs_Click" />
          <Button Style="{StaticResource ShellButton}" Content="About" Margin="0" Click="About_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid>
      <wv2:WebView2 x:Name="Web" />

      <!-- Shown instead of the viewer when it can't start. WebView2 is a native child window
           that always paints over WPF content, so the WebView is collapsed while this shows. -->
      <Border x:Name="ProblemPanel" Visibility="Collapsed" Background="{StaticResource ChromeBrush}">
        <StackPanel MaxWidth="600" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="ProblemTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock x:Name="ProblemText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14"
                     Foreground="{StaticResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Style="{StaticResource ShellButton}" Content="Open logs folder" Click="Logs_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
